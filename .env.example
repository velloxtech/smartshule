# ====================================================================
# SMARTSHULE CBC MANAGEMENT PLATFORM - ENVIRONMENT TEMPLATE
# ====================================================================
# Copy this file to .env and replace placeholder values with your credentials.

# --------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# --------------------------------------------------------------------
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=*

# --------------------------------------------------------------------
# 2. DATABASE CONFIGURATION & SWITCHER
# --------------------------------------------------------------------
# Database Adapter Selection: 'postgres' | 'mongodb' | 'in-memory'
DB_TYPE=postgres

# Database Target: 'local' (Localhost / Docker) | 'online' (Supabase / Render / Cloud)
DB_TARGET=online

# Local PostgreSQL Configuration
LOCAL_DATABASE_URL=postgresql://postgres:password@localhost:5432/smartshule?schema=public
LOCAL_DIRECT_URL=postgresql://postgres:password@localhost:5432/smartshule?schema=public

# Online Cloud PostgreSQL Configuration (e.g. Supabase)
ONLINE_DATABASE_URL=postgresql://postgres.xxx:password@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
ONLINE_DIRECT_URL=postgresql://postgres.xxx:password@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Active PostgreSQL URL (Auto-selected or manually overridden)
DATABASE_URL=postgresql://postgres:password@localhost:5432/smartshule?schema=public
DIRECT_URL=postgresql://postgres:password@localhost:5432/smartshule?schema=public

# MongoDB URL (Optional fallback)
MONGODB_URI=mongodb://localhost:27017/smartshule

# --------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT)
# --------------------------------------------------------------------
JWT_SECRET=your-jwt-secret-key-at-least-32-characters-long
JWT_REFRESH_SECRET=your-refresh-jwt-secret-key-at-least-32-characters
JWT_EXPIRY=1d
JWT_REFRESH_EXPIRY=7d

# --------------------------------------------------------------------
# 4. KCB BUNI DEVELOPER API PLATFORM (Paybill 522123, Bank & M-Pesa Rails)
# --------------------------------------------------------------------
# Obtain credentials from https://buni.kcbgroup.com/
KCB_BUNI_CONSUMER_KEY=your_kcb_buni_consumer_key
KCB_BUNI_CONSUMER_SECRET=your_kcb_buni_consumer_secret
KCB_BUNI_BASE_URL=https://uat.buni.kcbgroup.com
KCB_BUNI_SHORTCODE=522123
KCB_BUNI_SHARED_SHORTCODE=true
KCB_BUNI_CALLBACK_URL=https://api.smartshule.ac.ke/api/v1/finance/kcb-buni/callback

# --------------------------------------------------------------------
# 5. WHATSAPP GATEWAY API
# --------------------------------------------------------------------
# Option A: Real WhatsApp Account (Multi-Device QR Code pairing)
# Saved session tokens directory for Baileys multi-device protocol
WHATSAPP_SESSION_PATH=./data/whatsapp_session

# Option B: Meta WhatsApp Cloud API (Graph API)
# Get credentials from https://developers.facebook.com
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=smartshule_wa_verify_token_2026
WHATSAPP_APP_SECRET=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0

# --------------------------------------------------------------------
# 6. SAFARICOM M-PESA DARAJA GATEWAY API (DISABLED - INACTIVE)
# Active Payment Gateway: KCB Buni API Platform (Paybill 522123)
# --------------------------------------------------------------------
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=your_daraja_passkey
# MPESA_CONSUMER_KEY=your_daraja_consumer_key
# MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
# MPESA_ENV=sandbox
# MPESA_CALLBACK_URL=

# --------------------------------------------------------------------
# 7. SMS NOTIFICATION GATEWAYS (Africa's Talking / Twilio)
# --------------------------------------------------------------------
# Provider: 'africastalking' | 'twilio' | 'simulator'
SMS_PROVIDER=africastalking

# Africa's Talking Credentials (https://africastalking.com)
AFRICASTALKING_API_KEY=your_africastalking_api_key
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=SMARTSHULE

# Twilio SMS Credentials (Optional fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --------------------------------------------------------------------
# 8. EMAIL & SMTP NOTIFICATION GATEWAY
# --------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@smartshule.ac.ke
SMTP_PASS=your_email_app_password
SMTP_SECURE=false
EMAIL_FROM="SmartShule CBC Portal" <notifications@smartshule.ac.ke>

# --------------------------------------------------------------------
# 9. GOOGLE GEMINI AI & COMPUTER VISION API
# --------------------------------------------------------------------
# For automated homework grading, CBC progress insights, image recognition
# Get key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# --------------------------------------------------------------------
# 10. MEDIA & CLOUD STORAGE API
# --------------------------------------------------------------------
# Provider: 'local' | 'cloudinary' | 's3'
STORAGE_PROVIDER=local
UPLOAD_DIR=./data/uploads

# Cloudinary Credentials (Optional if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
