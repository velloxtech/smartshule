PORT=3000
NODE_ENV=development

# Database Adapter Selection: 'in-memory' | 'mongodb' | 'postgres'
DB_TYPE=in-memory

# MongoDB Local URL
MONGODB_URI=mongodb://localhost:27017/smartshule

# PostgreSQL Local URL (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartshule?schema=public

# Security & JWT
JWT_SECRET=smartshule-super-secret-jwt-key-2026
JWT_REFRESH_SECRET=smartshule-refresh-jwt-key-2026

# M-Pesa Daraja Gateway Settings
MPESA_SHORTCODE=174379
