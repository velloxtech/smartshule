datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  passwordHash String
  firstName    String
  lastName     String
  role         String
  phone        String?
  status       String   @default("ACTIVE")
  schoolId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Student {
  id                String   @id @default(uuid())
  admissionNumber   String   @unique
  upiNumber         String?  @unique
  firstName         String
  middleName        String?
  lastName          String
  dateOfBirth       String
  gender            String
  gradeLevel        String
  streamId          String
  schoolId          String
  academicYearId    String
  guardianIds       String[]
  medicalConditions String?
  specialNeeds      String?
  status            String   @default("ACTIVE")
  profilePhotoUrl   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Teacher {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  tscNumber              String?
  employeeNumber         String   @unique
  specialization         String[]
  assignedClassStreamIds String[]
  qualification          String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Guardian {
  id               String   @id @default(uuid())
  userId           String   @unique
  nationalId       String?
  occupation       String?
  relationship     String
  emergencyContact String
  studentIds       String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model School {
  id         String   @id @default(uuid())
  name       String
  code       String   @unique
  centerCode String?
  motto      String?
  email      String
  phone      String
  address    String
  logoUrl    String?
  currency   String   @default("KES")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AcademicYear {
  id        String   @id @default(uuid())
  name      String
  startDate String
  endDate   String
  isCurrent Boolean  @default(false)
  schoolId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AcademicTerm {
  id             String   @id @default(uuid())
  academicYearId String
  termNumber     Int
  name           String
  startDate      String
  endDate        String
  isCurrent      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ClassRoom {
  id             String   @id @default(uuid())
  name           String
  gradeLevel     String
  educationLevel String
  schoolId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Stream {
  id             String   @id @default(uuid())
  classRoomId    String
  name           String
  capacity       Int
  classTeacherId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model LearningArea {
  id             String   @id @default(uuid())
  name           String
  code           String
  gradeLevel     String
  educationLevel String
  isElective     Boolean  @default(false)
  schoolId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Strand {
  id             String   @id @default(uuid())
  learningAreaId String
  gradeLevel     String
  code           String
  title          String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SubStrand {
  id                       String   @id @default(uuid())
  strandId                 String
  code                     String
  title                    String
  specificLearningOutcomes String[]
  suggestedExperiences    String[]
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model FormativeAssessment {
  id                    String   @id @default(uuid())
  studentId             String
  teacherId             String
  learningAreaId        String
  subStrandId           String
  termId                String
  academicYearId        String
  assessmentDate        String
  assessmentMethod      String
  performanceLevel      String
  specificOutcomeTested String
  teacherRemarks        String?
  evidenceNotes         String?
  targetedCompetencies  String[]
  valuesObserved        String[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model SummativeAssessment {
  id                      String   @id @default(uuid())
  studentId               String
  teacherId               String
  learningAreaId          String
  termId                  String
  academicYearId          String
  strandScores            Json
  overallPerformanceLevel String
  teacherRemarks          String
  evaluationDate          String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model CbcReportCard {
  id                        String   @id @default(uuid())
  studentId                 String
  termId                    String
  academicYearId            String
  gradeLevel                String
  streamId                  String
  learningAreaAssessments   Json
  coreCompetencyAssessments Json
  valueAssessments          Json
  attendanceDaysPresent     Int
  attendanceDaysTotal       Int
  classTeacherRemarks       String
  headTeacherRemarks        String
  overallAverageScore       Float
  overallPerformanceLevel   String
  closingDate               String?
  nextTermOpeningDate       String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model SchemeOfWork {
  id               String    @id @default(uuid())
  teacherId        String
  learningAreaId   String
  classRoomId      String
  streamId         String?
  academicYearId   String
  termId           String
  title            String
  entries          Json
  status           String    @default("DRAFT")
  submittedAt      DateTime?
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewRemarks    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model LessonPlan {
  id                         String   @id @default(uuid())
  schemeOfWorkEntryId        String?
  teacherId                  String
  learningAreaId             String
  classRoomId                String
  streamId                   String?
  lessonDate                 String
  durationMinutes            Int
  rollBoys                   Int?
  rollGirls                  Int?
  strand                     String
  subStrand                  String
  specificLearningOutcomes   String[]
  keyInquiryQuestions        String[]
  coreCompetenciesAddressed  String[]
  valuesAddressed            String[]
  learningResources          String[]
  steps                      Json
  extendedActivity           String?
  teacherSelfReflection      String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model Timetable {
  id             String   @id @default(uuid())
  schoolId       String
  academicYearId String
  termId         String
  classRoomId    String
  streamId       String
  slots          Json
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AttendanceRegister {
  id                 String   @id @default(uuid())
  schoolId           String
  classRoomId        String
  streamId           String
  academicYearId     String
  termId             String
  date               String
  type               String
  lessonId           String?
  markedByTeacherId  String
  entries            Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model FeeStructure {
  id             String   @id @default(uuid())
  schoolId       String
  academicYearId String
  termId         String?  @default("ALL")
  gradeLevel     String
  title          String
  items          Json
  dueDate        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model StudentInvoice {
  id             String   @id @default(uuid())
  schoolId       String
  studentId      String
  feeStructureId String
  academicYearId String
  termId         String
  invoiceNumber  String   @unique
  items          Json
  amountBilled   Float
  discountAmount Float    @default(0)
  amountPayable  Float
  amountPaid     Float    @default(0)
  balance        Float
  status         String   @default("UNPAID")
  dueDate        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Payment {
  id                   String   @id @default(uuid())
  schoolId             String
  invoiceId            String
  studentId            String
  receiptNumber        String   @unique
  amount               Float
  paymentMethod        String
  transactionReference String   @unique
  mpesaPhoneNumber     String?
  paymentDate          String
  recordedByUserId     String
  status               String   @default("COMPLETED")
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model RecordOfWork {
  id                   String   @id @default(uuid())
  teacherId            String   // Links to the teacher making the record
  academicYearId       String?
  termId               String?
  week                 Int
  day                  String
  period               String?
  subjectAndGrade      String
  strandAndWorkCovered String
  reference            String
  comments             String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("records_of_work")
}

model Complaint {
  id                   String    @id @default(uuid())
  schoolId             String
  title                String
  description          String
  category             String    @default("GENERAL")
  priority             String    @default("MEDIUM")
  status               String    @default("OPEN")
  complainantName      String?
  complainantRole      String?
  complainantPhone     String?
  complainantEmail     String?
  complainantStudentId String?
  assignedToUserId     String?
  resolutionNotes      String?
  resolvedByUserId     String?
  resolvedAt           DateTime?
  createdByUserId      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("complaints")
}

model LunchEnrollment {
  id               String         @id @default(uuid())
  schoolId         String
  studentId        String
  academicYearId   String?
  termId           String?
  planName         String         @default("Standard Lunch")
  amount           Float          @default(0)
  amountPaid       Float          @default(0)
  balance          Float          @default(0)
  paymentStatus    String         @default("UNPAID")
  dietaryNotes     String?
  status           String         @default("ACTIVE")
  notes            String?
  enrolledByUserId String?
  enrolledAt       DateTime       @default(now())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  payments         LunchPayment[]

  @@map("lunch_enrollments")
}

model LunchPayment {
  id                   String          @id @default(uuid())
  lunchEnrollmentId    String
  lunchEnrollment      LunchEnrollment @relation(fields: [lunchEnrollmentId], references: [id], onDelete: Cascade)
  studentId            String
  schoolId             String
  amount               Float
  receiptNumber        String          @unique
  paymentMethod        String
  transactionReference String
  paymentDate          String
  recordedByUserId     String?
  notes                String?
  createdAt            DateTime        @default(now())

  @@map("lunch_payments")
}

model LunchExpense {
  id                   String   @id @default(uuid())
  schoolId             String
  title                String
  category             String
  amount               Float
  expenseDate          String
  paymentMethod        String
  paymentReference     String?
  vendorPayee          String
  receiptVoucherNumber String?
  termId               String?
  academicYearId       String?
  recordedByUserId     String?
  recordedByUserName   String?
  notes                String?
  receiptUrl           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("lunch_expenses")
}

model DeletedStudent {
  id                 String   @id @default(uuid())
  studentId          String   @map("student_id")
  admissionNumber    String   @map("admission_number")
  firstName          String   @map("first_name")
  middleName         String?  @map("middle_name")
  lastName           String   @map("last_name")
  upiNumber          String?  @map("upi_number")
  schoolId           String   @map("school_id")
  gradeLevel         String   @map("grade_level")
  classroomId        String?  @map("classroom_id")
  streamId           String?  @map("stream_id")
  academicYearId     String?  @map("academic_year_id")
  studentData        Json     @map("student_data")
  linkedData         Json     @map("linked_data")
  pendingWorkCleared Json     @map("pending_work_cleared")
  deletedAt          DateTime @default(now()) @map("deleted_at")
  deletedByUserId    String?  @map("deleted_by_user_id")
  reason             String?

  @@index([schoolId], map: "idx_deleted_students_school")
  @@index([studentId], map: "idx_deleted_students_student_id")
  @@index([admissionNumber], map: "idx_deleted_students_admission")
  @@map("deleted_students")
}

model Book {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  title           String
  author          String
  isbn            String?
  category        String   @default("CBC Textbooks")
  publisher       String?
  publicationYear Int?     @map("publication_year")
  copiesTotal     Int      @default(1) @map("copies_total")
  copiesAvailable Int      @default(1) @map("copies_available")
  shelfLocation   String?  @map("shelf_location")
  condition       String   @default("GOOD")
  gradeLevel      String?  @map("grade_level")
  coverImageUrl   String?  @map("cover_image_url")
  description     String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([schoolId], map: "idx_books_school")
  @@index([category], map: "idx_books_category")
  @@index([gradeLevel], map: "idx_books_grade")
  @@map("books")
}

model BookLoan {
  id                        String   @id @default(uuid())
  schoolId                  String   @map("school_id")
  bookId                    String   @map("book_id")
  bookTitle                 String   @map("book_title")
  borrowerType              String   @default("STUDENT") @map("borrower_type")
  borrowerId                String   @map("borrower_id")
  borrowerName              String   @map("borrower_name")
  borrowerAdmissionOrNumber String?  @map("borrower_admission_or_number")
  borrowerGradeOrClass      String?  @map("borrower_grade_or_class")
  issueDate                 String   @map("issue_date")
  dueDate                   String   @map("due_date")
  returnDate                String?  @map("return_date")
  status                    String   @default("ISSUED")
  fineAmount                Float    @default(0) @map("fine_amount")
  finePaid                  Boolean  @default(false) @map("fine_paid")
  remarks                   String?
  issuedByUserId            String?  @map("issued_by_user_id")
  receivedByUserId          String?  @map("received_by_user_id")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@index([schoolId], map: "idx_book_loans_school")
  @@index([bookId], map: "idx_book_loans_book")
  @@index([borrowerId], map: "idx_book_loans_borrower")
  @@index([status], map: "idx_book_loans_status")
  @@map("book_loans")
}