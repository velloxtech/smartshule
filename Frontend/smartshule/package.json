{
  "name": "smartshule-desktop",
  "productName": "SmartShule",
  "private": true,
  "version": "1.0.0",
  "description": "SmartShule - Grace Seeds School Management & CBC Tracking Desktop Client",
  "author": "Vellox Tech <support@velloxtech.com>",
  "homepage": "https://smartshule.ac.ke",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port=5173 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "cap:build": "npm run build && cap sync android",
    "cap:assemble": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "electron:start": "electron .",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --config electron-builder.json",
    "electron:build:linux": "npm run build && electron-builder --linux --config electron-builder.json",
    "electron:build:win": "npm run build && electron-builder --win --config electron-builder.json",
    "electron:build:mac": "npm run build && electron-builder --mac --config electron-builder.json",
    "electron:pack": "npm run build && electron-builder --dir --config electron-builder.json"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/network": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
