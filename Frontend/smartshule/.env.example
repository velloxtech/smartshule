# ====================================================================
# SMARTSHULE FRONTEND (REACT / VITE) - ENVIRONMENT TEMPLATE
# ====================================================================
# Copy this file to .env and adjust variables as required.

# Backend API Endpoint URL
# Defaults to '/api/v1' (routed through Vite dev proxy or production backend)
VITE_API_URL=/api/v1

# Application Identity & URLs
VITE_APP_NAME=SmartShule CBC Portal
VITE_APP_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Paystack Public Key (for frontend popup checkout & card entry)
# Get key from https://dashboard.paystack.com/#/settings/developers
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# WhatsApp Official School Desk Number
VITE_WHATSAPP_BOT_NUMBER=+254700000000

# Google Gemini AI API Key (Required for Gemini AI features)
VITE_GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_KEY=your_gemini_api_key
