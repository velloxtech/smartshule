            "body": {
              "mode": "raw",
              "raw": "{\n  \"strandId\": \"{{strandId}}\",\n  \"code\": \"SUB-SCIE-1.2\",\n  \"title\": \"Plant & Animal Cell Organelles\",\n  \"specificLearningOutcomes\": [\n    \"Identify nucleus, cytoplasm, and cell membrane under magnification\",\n    \"Distinguish plant cells from animal cells using chloroplasts and cell wall\",\n    \"Demonstrate care and safety when handling laboratory specimens\"\n  ],\n  \"suggestedExperiences\": [\n    \"Observing cheek cell smears under compound microscope\",\n    \"Creating clay models of plant cell structures\"\n  ]\n}"
            },
