    {
      "name": "6. Schemes of Work & Lesson Plans",
      "item": [
        {
          "name": "6.1 Create Scheme of Work",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"learningAreaId\": \"{{learningAreaId}}\",\n  \"classRoomId\": \"{{classRoomId}}\",\n  \"streamId\": \"{{streamId}}\",\n  \"academicYearId\": \"{{academicYearId}}\",\n  \"termId\": \"{{termId}}\",\n  \"title\": \"Grade 7 Integrated Science - Term 1 2026 Teaching Scheme\",\n  \"entries\": [\n    {\n      \"weekNumber\": 1,\n      \"lessonNumber\": 1,\n      \"strandTitle\": \"Living Things and Their Environment\",\n      \"subStrandTitle\": \"Microscope and Cell Structure\",\n      \"specificLearningOutcomes\": [\"Identify parts of a light microscope\"],\n      \"keyInquiryQuestions\": [\"How does a microscope aid scientific discovery?\"],\n      \"learningExperiences\": [\"Manipulate lenses and observe coarse/fine adjustments\"],\n      \"learningResources\": [\"Compound microscopes\", \"KLB Science Book 7\"],\n      \"assessmentMethods\": [\"Observation\", \"Oral questioning\"]\n    }\n  ]\n}"
