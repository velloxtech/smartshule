{
  "name": "smartshule-backend",
  "version": "1.0.0",
  "description": "SmartShule School Management & CBC Performance Tracking System Backend with Hexagonal Architecture",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "bootstrap": "ts-node scripts/bootstrap-production.ts",
    "dev": "ts-node-dev --respawn --transpile-only --watch src --ignore-watch node_modules src/index.ts",
    "dev:direct": "ts-node src/index.ts",
    "dev:frontend": "npm --prefix Frontend/smartshule run dev",
    "build:frontend": "npm --prefix Frontend/smartshule run build",
    "build:all": "npm run build && npm run build:frontend",
    "preview:frontend": "npm --prefix Frontend/smartshule run preview",
    "docker:build": "docker build -t smartshule:latest .",
    "docker:run": "docker run -p 3000:3000 --env-file .env smartshule:latest",
    "docker:compose": "docker compose up --build",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage",
    "db:switch": "ts-node scripts/db-switch.ts",
    "db:status": "ts-node scripts/db-switch.ts status",
    "db:local": "ts-node scripts/db-switch.ts local",
    "db:online": "ts-node scripts/db-switch.ts online",
    "cap:sync": "npm --prefix Frontend/smartshule run cap:sync",
    "cap:build": "npm --prefix Frontend/smartshule run cap:build",
    "cap:open": "npm --prefix Frontend/smartshule run cap:open"
  },
  "keywords": [
    "school-management",
    "CBC-curriculum",
    "hexagonal-architecture",
    "ports-and-adapters",
    "nodejs",
    "typescript"
  ],
  "author": "SmartShule Team",
  "license": "ISC",
  "dependencies": {
    "@types/nodemailer": "^8.0.2",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "morgan": "^1.12.0",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "jest": "^30.5.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
